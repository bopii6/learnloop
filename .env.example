# ============ LLM 配置（必填其一）============
# OpenAI 兼容协议：DeepSeek / GLM / 任意兼容端点都可以
# 推荐 DeepSeek：国内直连，注册充 10 元够用很久
# 获取：https://platform.deepseek.com/api_keys
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-你的key填这里
LLM_MODEL=deepseek-chat

# 备选：智谱 GLM（有免费额度）
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_API_KEY=你的glm key
# LLM_MODEL=glm-4-flash

# ============ 搜索配置（可选，填了质量更好）============
# Tavily（AI 搜索，免费 1000 次/月）：https://tavily.com
# 注意：国内访问可能不通，需要代理；不通就不填，自动走内置搜索
TAVILY_API_KEY=

# 博查搜索（国内 AI 搜索，有免费额度）：https://open.bochaai.com
BOCHA_API_KEY=

# ============ 语音识别（可选，语音+文字模式 Chrome 兜底）============
# Chrome 原生语音识别走 Google 服务（国内不可达），不可达时自动切换
# "本地录音整句 → 云端识别" 链路。识别用阿里百炼 qwen3-asr-flash，
# 与下面的 DASHSCOPE_API_KEY 共用同一把 key——配了语音播报就无需额外配置。

# ============ 云端语音合成（可选，白板播报更自然）============
# 不配置 = 白板/回放播报用浏览器系统音色（较机械）；
# 配置后 = 阿里云百炼 qwen3-tts-flash（0.8 元/万字符，1 汉字算 2 字符，开通送 1 万字符额度）。
# 获取：https://bailian.console.aliyun.com/?tab=model#/api-key （开通百炼服务 → 创建 API Key）
DASHSCOPE_API_KEY=
# 音色（默认 Elias=墨讲师，官方唯一为"讲课"设计的音色；备选 Neil=新闻主播、Maia=知性、Moon=率性男声、
#        Ethan=阳光男声；方言/角色音色见 https://help.aliyun.com/zh/model-studio/qwen-tts-voice-list）
# TTS_VOICE=Elias
# 模型（默认 instruct 版：同价，且只有它认下面的语气指令）
# TTS_MODEL=qwen3-tts-instruct-flash
# 语气指令（仅 instruct 系列模型生效；带指令的模型不支持 Andre 等少数音色，会报 InvalidParameter）
# TTS_INSTRUCTIONS=你是一位严谨、亲和、有耐心的专业讲师，正在给零基础的学生讲清一个机制。语速偏慢，吐字清晰，重点处自然放慢加重，句子之间留出呼吸。不要夸张、煽情或表演腔。
# 可选：Token Plan 专属 API Key（sk-ws- 开头，订阅 Token Plan 页面创建的那把）在标准端点不可用，
# 必须同时把端点换成你的专属域名（控制台「保存 API Key」弹窗里的 API Host）：
# TTS_ENDPOINT=https://<你的专属host>.cn-beijing.maas.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation

# ---- 邮箱登录（SMTP，可选）----
# 不配置 = 本地开发模式：验证码直接显示在登录弹窗里，不真发邮件
# 以 QQ 邮箱为例：SMTP_HOST=smtp.qq.com / SMTP_PORT=465 / SMTP_PASS=授权码（不是登录密码）
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=you@qq.com
# SMTP_PASS=你的授权码
# SMTP_FROM=you@qq.com

# ---- 会话签名密钥（可选，多实例部署时必须一致）----
# 不配置则本地自动生成（data/.auth-secret）
# AUTH_SECRET=

# ---- 教材 OCR（可选）----
# TEXTBOOK_OCR_LANG=chi_sim+eng
# TEXTBOOK_OCR_MAX_PAGES=100

# ---- Cloudflare 存储（可选：填了即启用，数据自动进你的 R2 桶）----
# 步骤：Cloudflare 控制台 → R2 → 创建一个桶（如 learnloop）
#       → R2 页面"管理 R2 API 令牌" → 创建 API 令牌（对象读和写），
#       得到 Access Key ID / Secret Access Key；账户 ID 在控制台首页右侧。
# CF_ACCOUNT_ID=
# CF_R2_BUCKET=learnloop
# CF_R2_ACCESS_KEY_ID=
# CF_R2_SECRET_ACCESS_KEY=
# 配好后重启，访问 /api/storage-check 验证往返读写。
