{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "learnloop",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  // 自定义域名 agent.hellojoy.top 已在 Cloudflare 面板绑定到本 Worker（持久生效）。
  // 不在此声明 routes：部署令牌无 zone routes 权限，声明会导致部署报认证错误。
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "RUNTIME": "workers",
    "LLM_BASE_URL": "https://api.deepseek.com",
    "LLM_MODEL": "deepseek-chat",
    "CF_ACCOUNT_ID": "25a5412b3b51b03386b6945004ba381b",
    "CF_R2_BUCKET": "learnloop",
    "TAVILY_API_KEY": "",
    "BOCHA_API_KEY": "",
    "TTS_ENDPOINT": "https://llm-ik6blki6l4cuobxe.cn-beijing.maas.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation"
  },
  "observability": {
    "enabled": true
  }
}
