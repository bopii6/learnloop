{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "learnloop",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  // 自定义域名：绑定后国内可直连（workers.dev 在国内被墙）
  "routes": [
    { "pattern": "agent.hellojoy.top", "custom_domain": true }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "RUNTIME": "workers",
    "LLM_BASE_URL": "https://api.deepseek.com",
    "LLM_MODEL": "deepseek-chat",
    "CF_ACCOUNT_ID": "25a5412b3b51b03386b6945004ba381b",
    "CF_R2_BUCKET": "learnloop",
    "TAVILY_API_KEY": "",
    "BOCHA_API_KEY": ""
  },
  "observability": {
    "enabled": true
  }
}
